<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="FacturacionPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.tup.programacion3.Entity.Articulo</class>
        <class>com.tup.programacion3.Entity.AuditoriaApp</class>
        <class>com.tup.programacion3.Entity.Cliente</class>
        <class>com.tup.programacion3.Entity.CondicionIva</class>
        <class>com.tup.programacion3.Entity.Contacto</class>
        <class>com.tup.programacion3.Entity.Domicilio</class>
        <class>com.tup.programacion3.Entity.EntityId</class>
        <class>com.tup.programacion3.Entity.FacturaVenta</class>
        <class>com.tup.programacion3.Entity.FacturaVentaDetalle</class>
        <class>com.tup.programacion3.Entity.ListaPrecio</class>
        <class>com.tup.programacion3.Entity.ListaPrecioArticulo</class>
        <class>com.tup.programacion3.Entity.Marca</class>
        <class>com.tup.programacion3.Entity.PuntoVenta</class>
        <class>com.tup.programacion3.Entity.Rubro</class>
        <class>com.tup.programacion3.Entity.TipoMoneda</class>
        <class>com.tup.programacion3.Entity.Usuario</class>

        <properties>
            <!-- Esquema por defecto para todas las entidades -->
            <property name="hibernate.default_schema" value="modeloventas" />
            <!-- Conexión a PostgreSQL -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/underBase" />
            <property name="jakarta.persistence.jdbc.user" value="postgres" />
            <property name="jakarta.persistence.jdbc.password" value="1234" />

            <!-- Dialecto explícito -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />

            <!-- Configuración de Hibernate -->

            <property name="hibernate.show_sql" value="false" />
            <property name="hibernate.format_sql" value="true" />
            <property name="hibernate.use_sql_comments" value="true" />
            <property name="hibernate.hbm2ddl.auto" value="create-drop" /> <!-- cambié esto de UPDATE a create-drop, para que cada vez que ejecutemos el main no se cree la misma fila siemrpe -->
        </properties>
    </persistence-unit>
</persistence>